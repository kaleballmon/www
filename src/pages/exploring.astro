---
import HeaderRule from "@components/HeaderRule.astro";
import Layout from "@layouts/Layout.astro";
import HeaderAnchor from "@components/HeaderAnchor.astro";
import type { ExplorationAstroInstance } from "@types";
import { getFilenameFromAstroInstance } from "@utils";

const matches: ExplorationAstroInstance[] = Object.values(
  import.meta.glob("../explorations/*.astro", { eager: true }),
);
---

<Layout title="Kaleb Allmon Exploring">
  <header>
    <HeaderAnchor />
    <h2>Exploring</h2>
  </header>
  <HeaderRule />
  <nav>
    <ul class="main-nav-list">
      {matches
        .sort((match_a, match_b) => match_b.publishDate - match_a.publishDate)
        .map((match) => (
          <li>
            <a href={`/projects/${getFilenameFromAstroInstance(match)}`}>
              {match.title}
            </a>
          </li>
        ))}
    </ul>
  </nav>
</Layout>
