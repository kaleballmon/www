---
import toof from "@images/toof.jpeg";

export const title = "Good Teeth";
export const publishDate = new Date("2026-11-01");
---

<style>
  .pic {
    width: 80%;
  }
</style>

<figure>
  <div class="flex flex-col items-center gap-4">
    <img src={toof.src} class="pic h-auto" />
    <figcaption>Watercolor on postcard</figcaption>
  </div>
</figure>
