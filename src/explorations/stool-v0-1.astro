---
import stool_1 from "@images/stoolv1/stool_1.mp4";
import stool_2 from "@images/stoolv1/stool_2.jpeg";
import stool_3 from "@images/stoolv1/stool_3.png";
import stool_4 from "@images/stoolv1/stool_4.jpeg";
import stool_5 from "@images/stoolv1/stool_5.jpeg";
import stool_6 from "@images/stoolv1/stool_6.jpeg";
import stool_7 from "@images/stoolv1/stool_7.mp4";
import stool_8 from "@images/stoolv1/stool_8.mp4";
import stool_9 from "@images/stoolv1/stool_9.png";

export const title = "Stool v0.1";
export const publishDate = new Date("2026-10-31");
---

<style>
  .stool-fig {
    width: 40%;
  }
</style>

<div class="w-full flex flex-col items-center gap-8">
  <video class="stool-fig h-auto" controls>
    <source src={stool_1} type="video/mp4" />
  </video>
  <img src={stool_2.src} class="stool-fig h-auto" />
  <img src={stool_3.src} class="stool-fig h-auto" />
  <img src={stool_4.src} class="stool-fig h-auto" />
  <div class="flex w-full justify-evenly">
    <img src={stool_5.src} class="stool-fig h-auto" />
    <img src={stool_6.src} class="stool-fig h-auto" />
  </div>
  <video class="stool-fig h-auto" controls>
    <source src={stool_7} type="video/mp4" />
  </video>
  <video class="stool-fig h-auto" controls>
    <source src={stool_8} type="video/mp4" />
  </video>
  <img src={stool_9.src} class="stool-fig h-auto" />
</div>
